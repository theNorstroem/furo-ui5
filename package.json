{
  "name": "@furo/ui5",
  "description": "SAP UI5 Web Components code completion and data bindings for @furo/open-models",
  "version": "2.0.0-RC.6",
  "homepage": "https://github.com/eclipse/eclipsefuro-web/tree/main/packages/furo-ui5",
  "repository": "git@github.com:eclipse/eclipsefuro-web.git",
  "author": {
    "name": "theNorstroem",
    "email": "",
    "url": "https://github.com/theNorstroem/"
  },
  "keywords": ["web-components", "flow based programming", "fbp"],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "./dist",
    "icon.svg",
    "README.md",
    "custom-elements.json",
    "web-types.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json",
    "./web-types.json": "./web-types.json",
    "./dist/custom-elements-internal.json": "./dist/custom-elements-internal.json"
  },
  "scripts": {
    "start": "tsc && concurrently -k -r 'vite dev' 'tsc --watch'",
    "test": "vitest run --coverage",
    "test:debug": "vitest watch --inspect-brk --no-file-parallelism",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "build": "rimraf dist && npm run analyze && npm run analyze:internal && npm run analyze:deep && npm run gen:intrinsic && tsc && tsc-alias",
    "build:skipJSX": "rimraf dist && npm run analyze && npm run analyze:internal && npm run analyze:deep && tsc && tsc-alias",
    "tsc": "tsc && tsc-alias",
    "gen:intrinsic:pure": "node ./scripts/IntrinsicElements/main.js  && prettier src/JSX/*.ts --write",
    "gen:intrinsic": "rimraf src/JSX/* && node ./scripts/IntrinsicElements/main.js @furo/ui5 && eslint --version && eslint --fix src/JSX && prettier src/JSX/*.ts --write",
    "gen:contracts": "npm run clean:models && contracts/protoc-gen-open-models.sh && eslint ./src/models --fix && prettier --ext .ts ./src/models --write --ignore-path .gitignore",
    "clean:models": "rimraf src/models/furo && rimraf src/models/google && rimraf src/models/openapiv3",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "lint:fix:tests": "eslint ./test --fix",
    "format": "prettier './src/**/*.ts' --write --ignore-path .gitignore",
    "format:tests": "prettier './test/**/*.ts' --write --ignore-path .gitignore",
    "docs:start": "cd documentation/hugo && hugo serve",
    "docs:generate": "npm run analyze:components && npm run analyze:typerenderer && ./scripts/cem.sh",
    "docs:publish": "./scripts/publishDocs.sh",
    "analyze": "cem analyze --litelement --globs ./src/* --outdir ./dist",
    "analyze:internal": "cem analyze --config scripts/internal-cem.config.mjs && mv tmp/custom-elements.json dist/custom-elements-internal.json",
    "analyze:deep": "cem analyze --config ./scripts/deep-cem.config.mjs &&  ./scripts/WebtypesPostprocessor.mjs && ./scripts/CheckWebtypes.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@furo/fbp": "^6.15.0",
    "@furo/layout": "/Users/veith/Projects/theNorstroem/eclipsefuro-web/packages/furo-layout/furo-layout-3.0.0-RC.11.tgz",
    "@furo/open-models": "^1.20.0",
    "@furo/route": "^4.0.0",
    "@furo/util": "^2.2.2",
    "@ui5/webcomponents": "2.22.0",
    "@ui5/webcomponents-base": "2.22.0",
    "@ui5/webcomponents-compat": "2.22.0",
    "@ui5/webcomponents-fiori": "2.22.0",
    "@ui5/webcomponents-icons": "2.22.0",
    "@ui5/webcomponents-icons-business-suite": "2.22.0",
    "@ui5/webcomponents-icons-tnt": "2.22.0",
    "@ui5/webcomponents-localization": "2.22.0",
    "@ui5/webcomponents-theming": "2.22.0",
    "lit": "^3.3.1",
    "react": "^19.2.4"
  },
  "dependencies": {
    "markdown-it": "^14.1.1",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@furo/web-types": "^0.1.0",
    "@jackolope/ts-lit-plugin": "^3.1.6",
    "@open-wc/testing-helpers": "^3.0.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@storybook/web-components": "^10.4.0",
    "@storybook/web-components-vite": "^10.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/browser": "^4.1.6",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "@wc-toolkit/storybook-helpers": "^10.3.0",
    "axe-core": "^4.11.4",
    "cem-plugin-vs-code-custom-data-generator": "^1.4.2",
    "chai-a11y-axe": "^1.5.0",
    "concurrently": "^9.2.1",
    "custom-element-jet-brains-integration": "^1.7.0",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-storybook": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.0",
    "tsc-alias": "^1.8.17",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json",
  "web-types": "./web-types.json"
}
