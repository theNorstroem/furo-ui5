# Save list of initially staged files (one per line)
STAGED_FILES="$(git diff --cached --name-only)"

npm run format || exit 1
npm run lint:fix || exit 1
npm run build || exit 1

# Re-add only the previously staged files (if it exists)
echo "$STAGED_FILES" | while read file; do
  [ -e "$file" ] && git add "$file"
done

# List all modified (but unstaged) files after fixes
ALL_MODIFIED="$(git ls-files -m)"

UNSTAGED_MODIFIED=""
for file in $ALL_MODIFIED; do
  echo "$STAGED_FILES" | grep -q "^$file$" || UNSTAGED_MODIFIED="$UNSTAGED_MODIFIED\n$file"
done

# If any unstaged file was changed, abort the commit
if [ -n "$UNSTAGED_MODIFIED" ]; then
  echo "Either you have unstaged changes or some unstaged files were modified by lint/format."
  echo "$UNSTAGED_MODIFIED" | sed '/^$/d'
  echo "Please stage them if needed and retry your commit."
  exit 1
fi
