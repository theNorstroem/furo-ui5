{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "declaration": true,
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "DOM",
      "DOM.Iterable"
    ],
    "useDefineForClassFields": false,
    "plugins": [
      {
        "name": "@jackolope/ts-lit-plugin",
        "strict": true,
        "customHtmlData": ["./dist/furo-ui5.html-data.json", "./node_modules/@furo/layout/dist/furo-layout.html-data.json"],
        "globalAttributes": ["flex", "scroll"],
        "rules": {
          "no-incompatible-type-binding": "warn",
          "no-incompatible-property-type": "error",
          "no-unknown-event": "warn",
          "no-unknown-attribute": "error",
          "no-unknown-property": "error",
          "no-complex-attribute-binding": "error"
        }
      }
    ],
    "allowArbitraryExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "rootDir": "./src/",
    "stripInternal": true,
    "types": [],
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": [
    "src/**/*.ts",
    "global.d.ts"
  ],
  "exclude": [
    "src/type-renderers-wip/**/*.ts"
  ]
}
